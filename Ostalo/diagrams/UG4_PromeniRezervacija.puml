@startuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
hide footbox

participant "c:Controller" as C
participant "so:PromeniRezervacijaSO" as SO
participant "r:Repository" as R

C -> SO : execute(Rezervacija)
activate SO

SO -> SO : precondition(Rezervacija)
note right of SO
  Proverava idRezervacija, Agent, Putnik,
  statusPlacanja i da lista stavki nije
  prazna, i za svaku StavkaRezervacije
  proverava brojOsoba, datume polaska/dolaska
  i Aranzman.
end note

note right of SO
  Za svaku StavkaRezervacije se prethodno
  ponovo izračunavaju popust i cena,
  bez poziva ka Repository-ju.
end note

SO -> R : edit(Rezervacija)
activate R
R --> SO : signal
deactivate R

SO -> R : getAll(new StavkaRezervacije(), "idRezervacija = ?", [idRezervacija])
activate R
R --> SO : List<GenericEntity>
deactivate R

loop [za svaku postojeću stavku]
    SO -> R : delete(GenericEntity)
    activate R
    R --> SO : signal
    deactivate R
end

loop [za svaku novu StavkaRezervacije iz rezervacija.getStavke()]
    SO -> R : add(StavkaRezervacije)
    activate R
    R --> SO : signal
    deactivate R
end

SO --> C : Rezervacija
deactivate SO

@enduml
