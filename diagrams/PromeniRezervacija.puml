@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam monochrome true
skinparam sequenceMessageAlign center
hide footbox

participant "k:Controller" as K
participant "so:PromeniRezervacijaSO" as SO
participant "r:RepositoryDbGeneric" as R

K -> SO : execute(Rezervacija)
activate SO

SO -> SO : precondition(Rezervacija)

alt idRezervacija postoji i ograničenja su zadovoljena
    SO -> R : connect()
    R --> SO : signal

    SO -> SO : executeOperation(Rezervacija)

    loop za svaku stavku rezervacije
        SO -> SO : popust = brojOsoba >= 3 ? 0.1 : 0.0
        SO -> SO : cena = brojOsoba * aranzman.getCenaPoOsobi() * (1 - popust)
        SO -> SO : setPopust(popust); setCena(cena)
    end
    SO -> SO : ukupanIznos = suma svih cena
    SO -> SO : setUkupanIznos(ukupanIznos)

    SO -> R : edit(Rezervacija)
    R --> SO : signal

    SO -> R : getAll(StavkaRezervacije, "idRezervacija = ?", [idRezervacija])
    R --> SO : List<GenericEntity>

    loop za svaku postojeću stavku rezervacije
        SO -> R : delete(StavkaRezervacije)
        R --> SO : signal
    end

    loop za svaku novu stavku rezervacije
        SO -> SO : setRezervacija(rezervacija); setRb(rb++)
        SO -> R : add(StavkaRezervacije)
        R --> SO : signal
    end

    SO -> R : commit()
    R --> SO : signal

    SO --> K : Rezervacija
else ograničenja nisu zadovoljena
    SO -> R : rollback()
    R --> SO : signal
    SO --> K : Exception("Систем не може да запамти резервацију")
end

deactivate SO

@enduml
