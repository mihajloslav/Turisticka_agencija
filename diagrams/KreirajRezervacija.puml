@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam monochrome true
skinparam sequenceMessageAlign center
hide footbox

participant "k:Controller" as K
participant "so:KreirajRezervacijaSO" as SO
participant "r:RepositoryDbGeneric" as R

K -> SO : execute(Rezervacija)
activate SO

SO -> SO : precondition(Rezervacija)

alt strukturna i vrednosna ograničenja zadovoljena
    SO -> R : connect()
    R --> SO : signal

    SO -> SO : executeOperation(Rezervacija)

    opt datumKreiranja == null
        SO -> SO : setDatumKreiranja(LocalDate.now())
    end

    loop za svaku stavku rezervacije
        SO -> SO : popust = brojOsoba >= 3 ? 0.1 : 0.0
        SO -> SO : cena = brojOsoba * aranzman.getCenaPoOsobi() * (1 - popust)
        SO -> SO : setPopust(popust); setCena(cena)
    end
    SO -> SO : ukupanIznos = suma svih cena
    SO -> SO : setUkupanIznos(ukupanIznos)

    SO -> R : add(Rezervacija)
    R --> SO : signal

    loop za svaku stavku rezervacije
        SO -> SO : setRezervacija(rezervacija); setRb(rb++)
        SO -> R : add(StavkaRezervacije)
        R --> SO : signal
    end

    SO -> R : commit()
    R --> SO : signal

    SO --> K : Rezervacija
else ograničenja nisu zadovoljena
    SO -> R : rollback()
    R --> SO : signal
    SO --> K : Exception("Систем не може да креира резервацију")
end

deactivate SO

@enduml
